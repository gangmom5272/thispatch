# 셸 스크립트는 반드시 LF 여야 한다.
# Windows 에서 클론하면 core.autocrlf 때문에 CRLF 로 받아지고,
# 그러면 WSL 에서 실행할 때 아래처럼 실패한다.
#   bash: ./04-wsl-node.sh: /usr/bin/env^M: bad interpreter
*.sh            text eol=lf
*.bash          text eol=lf

# PowerShell 은 CRLF 가 자연스럽다
*.ps1           text eol=crlf

# 그 밖의 텍스트 파일에는 text 속성을 주지 않는다.
# 주면 기존 파일 전체가 줄바꿈 정규화 대상이 되어, 손대지도 않은 README.md 가
# 450+/450- 변경으로 잡히고 팀원 수정과 충돌한다. (실측)

# 바이너리는 diff 를 시도하지 않게 한다
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.jar           binary
*.war           binary
*.class         binary
*.tar.gz        binary
*.tgz           binary
*.zip           binary

# Gradle 래퍼 — gradlew 는 WSL/리눅스에서 실행되므로 LF
/gradlew        text eol=lf
*.bat           text eol=crlf
