POSTGRES_DB=thispatch
POSTGRES_USER=thispatch
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 로컬 Redis. compose.yaml은 127.0.0.1:6379에 비밀번호 없이 공개한다.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s

# 개발용 주소. CORS 주소는 경로/끝 슬래시 없이 쉼표로 구분한다.
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 32바이트 이상의 난수를 Base64로 인코딩한 값. README의 생성 방법 참고.
# 공용 기본키는 제공하지 않는다. 실행 전 반드시 채운다.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Steam 로그인 코드 유효기간. 양의 정수 초 단위 Duration.
STEAM_LOGIN_CODE_TTL=5m

# 로컬 백엔드는 로컬로 전달한 터널 주소를 입력한다. 서버 Docker 주소를 그대로 쓰지 않는다.
AI_BASE_URL=
AI_CONNECT_TIMEOUT=3s
AI_READ_TIMEOUT=30s

# DeepL API 전용 키. :fx로 끝나면 Free, 나머지는 Pro 주소를 자동 선택한다.
DEEPL_API_KEY=
DEEPL_CONNECT_TIMEOUT=3s
DEEPL_READ_TIMEOUT=10s
