# 서버1 배포용 환경변수 — 서버의 infra/.env 로 복사해 채운다.
#
#   cp infra/.env.example infra/.env
#   vi infra/.env
#
# ⚠ .env 는 저장소에 올리지 않는다 (.gitignore 로 막혀 있다).
#   서버에만 둔다.

# Jenkins 관리자. JCasC 가 기동 시 이 계정을 만든다.
# 비밀번호는 직접 정한다. 초기 토큰(initialAdminPassword)은 쓰지 않는다.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
JENKINS_ADMIN_EMAIL=rudalstbvj@naver.com

# 호스트 docker 그룹 GID. 16-server-jenkins.sh 가 자동으로 읽어 넘기므로
# 보통 건드릴 필요 없다. (서버1 실측 988)
# DOCKER_GID=988

# ── 서비스 DB ────────────────────────────────────────────────
# 서버1 의 '호스트' PostgreSQL 17.11 에 붙는다. 컨테이너가 아니다.
# 백엔드 컨테이너는 host.docker.internal 로 호스트를 본다 (compose 가 이어준다).
#
# DB 이름은 로컬 개발과 같게 thispatch 로 맞췄다.
# 2026-09-13 이전에는 thispatch 에 옛 스키마가 있었는데, 데이터가 0건이라
# 덤프만 서버2A 에 보관하고 새로 만들었다.
POSTGRES_DB=thispatch
POSTGRES_USER=thispatch
POSTGRES_PASSWORD=change-me

# 실행할 Spring 프로파일.
# backend/src/main/resources 에 application-prod.yaml 이 생기면 prod 로 바꾼다.
# 그전까지는 dev 로 둔다 — dev 도 DB 접속을 전부 환경변수로 받고,
# .env 파일 읽기가 optional: 이라 컨테이너 안에 파일이 없어도 안 죽는다.
SPRING_PROFILES_ACTIVE=dev

# ── GitLab 연동 (배포 파이프라인) ───────────────────────────
# Jenkins 가 저장소를 clone 하고, GitLab 이 push 를 알려줄 때 쓴다.
#
# 만드는 곳 — GitLab 프로젝트 > Settings > Repository > Deploy tokens
#   이름     jenkins
#   범위     read_repository 만 (write 는 주지 않는다)
# 만들면 username 과 token 이 한 번만 보인다. 그때 여기 옮겨 적는다.
GITLAB_REPO_USER=jenkins
GITLAB_REPO_TOKEN=change-me

# 웹훅이 자기 신분을 증명하는 값. 아무 긴 무작위 문자열이면 된다.
#   openssl rand -hex 24
# GitLab 웹훅 설정의 Secret token 칸에 같은 값을 넣는다.
# 이게 없으면 주소만 아는 사람이 아무나 배포를 돌릴 수 있다.
GITLAB_WEBHOOK_SECRET=change-me

# ── Mattermost 알림 (20-mattermost-alert.sh) ────────────────
# 노드나 서비스가 죽으면 여기로 알린다.
#
# 만드는 곳 — Mattermost 좌상단 점 9개(⠿) > 통합 > 들어오는 웹후크 > 추가
#   제목         디스패치 노드 감시
#   채널         노드 알림
#   이 채널로 고정  체크  ← 주소가 새어도 그 채널에만 쓸 수 있게 막는다
#
# ⚠ 이 주소를 아는 사람은 누구나 채널에 글을 쓸 수 있다.
#   DB 비밀번호와 같은 취급을 할 것. 저장소에 절대 넣지 말 것.
#
# 비워두면 검사는 돌지만 아무 데도 보내지 않는다.
# 마스터 노트북에는 .env 가 없으므로 ~/.thispatch/mattermost-webhook 에 넣는다.
MATTERMOST_WEBHOOK=
